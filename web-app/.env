# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=garmentpos
DB_USER=postgres
DB_PASSWORD=root
DB_TYPE=postgres

# Sync Configuration
SYNC_INTERVAL=30000
MAX_RETRIES=3
CONFLICT_STRATEGY=timestamp
PREFERRED_SOURCE=postgres

# NeDB Configuration (for legacy sync support)
NEDB_HOST=localhost
NEDB_PORT=49499
NEDB_PATH=./data/databases

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Server Configuration
PORT=3001

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Logging Configuration
LOG_LEVEL=info
